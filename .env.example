# Copy to .env and fill in values before running docker compose.
# All variables have sane defaults for single-GPU laptop dev.
# Override for cluster as noted.

# ── HuggingFace ──────────────────────────────────────────────────────────────
# Required to download Qwen, SigLIP 2 without rate limits.
HUGGING_FACE_HUB_TOKEN=hf_...

# ── GPU assignment ────────────────────────────────────────────────────────────
# MinerU, Vision, and ChemVLM are lightweight — they share a single GPU.
# The LLM defaults to all visible GPUs (NVIDIA_VISIBLE_DEVICES=all) and
# auto-detects TENSOR_PARALLEL_SIZE from the GPU count at startup.
# Override only if you need to restrict which GPUs the LLM uses.
MINERU_GPUS=0
VISION_GPUS=0
CHEMVLM_GPUS=0
# LLM_GPUS=0,1,2,3        # optional: restrict LLM to specific GPUs
# TENSOR_PARALLEL_SIZE=4   # optional: override auto-detection

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_MODEL_NAME=Qwen/Qwen3.6-72B-Instruct
TENSOR_PARALLEL_SIZE=1  # cluster: match number of LLM_GPUS (e.g. 4)
LLM_DTYPE=auto          # cluster with bf16 support: bfloat16
LLM_MAX_MODEL_LEN=32768

# ── Vision ───────────────────────────────────────────────────────────────────
VISION_TRIAGE_MODEL=google/siglip2-so400m-patch14-384
VISION_BATCH_SIZE=8

# ── ChemVLM ──────────────────────────────────────────────────────────────────
CHEMVLM_MODEL_ID=Noct25/TinyChemVL
CHEMVLM_QUANTIZE=4bit   # cluster with >=16 GB VRAM per GPU: none (bf16)
CHEMVLM_MAX_NEW_TOKENS=512

# ── Orchestrator ──────────────────────────────────────────────────────────────
OUTPUT_DIR=/outputs      # maps to ./outputs on the host via volume mount
